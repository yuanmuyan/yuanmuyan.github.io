---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import { profileConfig, siteConfig } from "@/config";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	  data-overlayscrollbars-initialize
>
	<head>

		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? url(favicon.src) : favicon.src}
				  sizes={favicon.sizes}
				  media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}
		<link rel="manifest" href={url("/site.webmanifest")} />
		<link rel="apple-touch-icon" sizes="180x180" href={url("/favicon/avatar-180.png")} />
		<meta name="theme-color" content="#9fdfd0" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#123331" media="(prefers-color-scheme: dark)" />

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script is:inline define:vars={{DEFAULT_THEME, LIGHT_MODE, DARK_MODE, AUTO_MODE, BANNER_HEIGHT_EXTEND, PAGE_WIDTH, configHue}}>
			// Load the theme from local storage
			const theme = localStorage.getItem('theme') || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove('dark');
					break
				case DARK_MODE:
					document.documentElement.classList.add('dark');
					break
				case AUTO_MODE:
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('dark');
					} else {
						document.documentElement.classList.remove('dark');
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem('hue') || configHue;
			document.documentElement.style.setProperty('--hue', hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>

		<!-- ===== 入场动画：第一次进站时，在幕布上把名字「写」出来（Allura 签名体 + 扫掠笔尖）+ 萤火虫，收焦后揭开 =====
		     样式放这里（内联）是为了在第一帧就画上幕布，不然会先闪一下页面。
		     颜色直接吃站上那套变量，所以明暗两个主题都是本来的底色。 -->
		<style is:inline>
			#intro {
				--intro-ink: oklch(0.70 0.14 var(--hue));
				--intro-bg: oklch(0.95 0.01 var(--hue));
				/* 揭幕用：--intro-iris 是幕布中间那个「洞」的半径，由脚本逐帧放大 */
				--intro-iris: 0px;
				position: fixed;
				inset: 0;
				z-index: 9999;
				display: grid;
				place-items: center;
				background: var(--intro-bg);
				-webkit-mask-image: radial-gradient(circle at 50% 50%, transparent 0, transparent var(--intro-iris), #000 calc(var(--intro-iris) + 1.5px));
				mask-image: radial-gradient(circle at 50% 50%, transparent 0, transparent var(--intro-iris), #000 calc(var(--intro-iris) + 1.5px));
				mask-repeat: no-repeat;
			}
			html.dark #intro {
				--intro-ink: oklch(0.75 0.14 var(--hue));
				--intro-bg: oklch(0.16 0.014 var(--hue));
			}
			#intro .intro-box {
				grid-area: 1 / 1;
				width: min(78vw, 900px);
			}
			#intro svg {
				display: block;
				width: 100%;
				height: auto;
				overflow: visible;
			}
			#intro #introInk {
				fill: var(--intro-ink);
				font-family: "Allura Signature", "Segoe Script", "Brush Script MT", cursive;
				font-size: 1000px;
				font-kerning: none;
				font-variant-ligatures: none;
				text-rendering: geometricPrecision;
			}
			#intro #introTip {
				fill: url(#introTipGrad);
			}
			#intro #introTipGrad stop {
				stop-color: var(--intro-ink);
			}
			/* 收焦用的静态糊层：内容跟着清晰层实时变（<use> 是活的），但只在收焦那 420ms 里才显示 */
			#intro #introBlur {
				display: none;
				opacity: 0;
				filter: blur(26px);
			}
			#intro .intro-flies {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			#intro .intro-fly {
				position: absolute;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--intro-ink);
				opacity: 0;
				box-shadow: 0 0 10px 3px color-mix(in srgb, var(--intro-ink) 55%, transparent);
			}
			@keyframes introDrift {
				0% { transform: translate3d(0, 0, 0) scale(1); }
				25% { transform: translate3d(24px, -18px, 0) scale(1.15); }
				50% { transform: translate3d(-14px, -34px, 0) scale(0.9); }
				75% { transform: translate3d(18px, -12px, 0) scale(1.05); }
				100% { transform: translate3d(0, 0, 0) scale(1); }
			}
			@media (max-width: 700px) {
				#intro .intro-box { width: 86vw; }
			}
			/* 系统开了「减少动态效果」就别挡住人家：直接不出现（JS 里也会再拦一次） */
			@media (prefers-reduced-motion: reduce) {
				#intro { display: none; }
			}
		</style>
		<noscript><style>#intro { display: none !important; }</style></noscript>

		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

	</head>
	<body class=" min-h-screen transition " class:list={[{"lg:is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<!-- ===== 入场动画的幕布 + 脚本 =====
		     每会话只播一次；点击 / 滚动 / 按任意键跳过；系统开了「减少动态效果」就不播（CSS 里也兜了一层）。
		     想反复看：地址栏加 ?intro=1　想这次跳过：?intro=0 -->
		<div id="intro" aria-hidden="true">
			<div class="intro-flies" id="introFlies"></div>
			<div class="intro-box" id="introSharpBox">
				<svg viewBox="0 0 4142.89 672">
					<defs>
						<mask id="introSweepMask" maskUnits="userSpaceOnUse" x="-140" y="-40" width="4400" height="752">
							<rect id="introSweepRect" x="-140" y="-40" width="0" height="752" fill="#fff" />
						</mask>
						<radialGradient id="introTipGrad">
							<stop offset="0" stop-opacity="1" />
							<stop offset="0.4" stop-opacity="0.55" />
							<stop offset="1" stop-opacity="0" />
						</radialGradient>
						<filter id="introSoft" x="-60%" y="-60%" width="220%" height="220%">
							<feGaussianBlur stdDeviation="16" />
						</filter>
					</defs>
					<g id="introSharp">
						<text id="introInk" x="0" y="303" opacity="0.82" mask="url(#introSweepMask)">yuanmuyan</text>
						<circle id="introTip" r="30" cx="-300" cy="-300" opacity="0" filter="url(#introSoft)" />
					</g>
				</svg>
			</div>
			<!-- 收焦要用的静态糊层：内容用 <use> 引着上面那层（是活的），但只在收焦那 420ms 里才显示 -->
			<div class="intro-box" id="introBlur">
				<svg viewBox="0 0 4142.89 672">
					<use href="#introSharp" />
				</svg>
			</div>
		</div>
		<script is:inline>
			(() => {
				if (window.__introStarted) return;
				window.__introStarted = true;

				const root = document.getElementById("intro");
				if (!root) return;

				const motionOK = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				const want = new URLSearchParams(location.search).get("intro");
				let seen = false;
				try {
					seen = sessionStorage.getItem("yuanmuyan-intro-v1") === "1";
				} catch {
					seen = false;
				}

				// 不用播的几种情况：系统关了动画 / 地址栏写了 ?intro=0 / 这一次会话已经看过了
				if (!motionOK || want === "0" || (seen && want !== "1")) {
					root.remove();
					return;
				}
				try {
					sessionStorage.setItem("yuanmuyan-intro-v1", "1");
				} catch {
					/* 隐私模式下写不进去也没事，顶多下次再看一遍 */
				}

				// 笔尖轨迹：82 个点，跟 SVG 同一套坐标（按 Allura 的墨迹重心算出来的）
				const TIP = [
					[0, 613.13], [51.18, 588.41], [102.37, 570.58], [153.55, 328.75],
					[204.74, 337.84], [255.92, 335.7], [307.1, 347.56], [358.29, 366.25],
					[409.47, 297.68], [460.66, 231.37], [511.84, 172.18], [563.02, 110.52],
					[614.21, 99.78], [665.39, 194.38], [716.58, 209.93], [767.76, 148.08],
					[818.94, 132.78], [870.13, 163.61], [921.31, 221.59], [972.49, 171.05],
					[1023.68, 204.93], [1074.86, 135.41], [1126.05, 99.18], [1177.23, 192.32],
					[1228.41, 226.59], [1279.6, 220.48], [1330.78, 189.27], [1381.97, 169.86],
					[1433.15, 165.42], [1484.33, 149.63], [1535.52, 126.04], [1586.7, 97.45],
					[1637.89, 181.65], [1689.07, 136.27], [1740.25, 140.07], [1791.44, 264.36],
					[1842.62, 229.92], [1893.81, 245.2], [1944.99, 194.38], [1996.17, 113.33],
					[2047.36, 106.26], [2098.54, 118.85], [2149.73, 196.76], [2200.91, 191.26],
					[2252.09, 111.19], [2303.28, 107.32], [2354.46, 256.03], [2405.65, 221.04],
					[2456.83, 245.06], [2508.01, 205.81], [2559.2, 134.99], [2610.38, 98.09],
					[2661.57, 133.84], [2712.75, 94.41], [2763.93, 160.97], [2815.12, 112.74],
					[2866.3, 74.04], [2917.48, 117.74], [2968.67, 204.69], [3019.85, 156.79],
					[3071.04, 152.15], [3122.22, 265.47], [3173.4, 231.59], [3224.59, 192.16],
					[3275.77, 207.71], [3326.96, 145.68], [3378.14, 135.01], [3429.32, 171.11],
					[3480.51, 218.26], [3531.69, 166.06], [3582.88, 203.82], [3634.06, 128.38],
					[3685.24, 101.31], [3736.43, 514.76], [3787.61, 467.75], [3838.8, 363.12],
					[3889.98, 329.08], [3941.16, 338.37], [3992.35, 338.95], [4043.53, 357.23],
					[4094.72, 345.56], [4141.38, 279.63],
				];

				const inkEl = document.getElementById("introInk");
				const sweepRect = document.getElementById("introSweepRect");
				const tipEl = document.getElementById("introTip");
				const sharpBox = document.getElementById("introSharpBox");
				const blurBox = document.getElementById("introBlur");
				const flyLayer = document.getElementById("introFlies");

				// 萤火虫：桌面 7 只，手机 5 只
				const flies = [];
				const flyCount = window.matchMedia("(max-width: 700px)").matches ? 5 : 7;
				for (let i = 0; i < flyCount; i++) {
					const el = document.createElement("div");
					el.className = "intro-fly";
					el.style.left = 12 + Math.random() * 76 + "vw";
					el.style.top = 14 + Math.random() * 66 + "vh";
					el.style.animation =
						"introDrift " +
						(9 + Math.random() * 7).toFixed(2) +
						"s ease-in-out " +
						(-Math.random() * 6).toFixed(2) +
						"s infinite";
					flyLayer.appendChild(el);
					flies.push({ el: el, at: 0.45 + (i / flyCount) * 0.3 });
				}

				// 时间轴（毫秒）：写 0–800 → 虫子 500–1050 → 凝实 700–1120 → 收焦 1020–1440 → 揭幕（中间扩散）1150–1500
				const T = { sweep: [0, 800], fly: [500, 1050], settle: [700, 1120], focus: [1020, 1440], uncover: [1150, 1500] };
				const clamp01 = (v) => Math.min(1, Math.max(0, v));
				const easeOut = (t) => 1 - Math.pow(1 - t, 3);
				const easeInOut = (t) => 0.5 - 0.5 * Math.cos(Math.PI * t); // 起笔收笔慢一点、中间匀，才有手写味
				const seg = (t, ab) => clamp01((t - ab[0]) / (ab[1] - ab[0]));

				let raf = 0;
				let startedAt = 0;
				let started = false;
				let finished = false;
				let inkWidth = 4200;
				let irisMax = 2400; // 揭幕时那个洞最大要多大（够盖住到四角就行），开播时按视口算

				function tipAt(p) {
					const f = p * (TIP.length - 1);
					const i = Math.min(TIP.length - 2, Math.floor(f));
					const k = f - i;
					return [TIP[i][0] + (TIP[i + 1][0] - TIP[i][0]) * k, TIP[i][1] + (TIP[i + 1][1] - TIP[i][1]) * k];
				}

				function dropListeners() {
					window.removeEventListener("click", skip);
					window.removeEventListener("wheel", skip);
					window.removeEventListener("keydown", skip);
				}

				function finish() {
					if (finished) return;
					finished = true;
					cancelAnimationFrame(raf);
					dropListeners();
					root.remove(); // 站上本来就有一层常驻萤火虫，这块拿掉之后视觉接得上
				}

				function skip() {
					if (finished) return;
					finished = true;
					cancelAnimationFrame(raf);
					dropListeners();
					root.remove();
				}

				function render(t) {
					const sweep = easeInOut(seg(t, T.sweep));
					sweepRect.setAttribute("width", (sweep * (inkWidth + 90)).toFixed(2));
					const pt = tipAt(sweep);
					tipEl.setAttribute("cx", pt[0].toFixed(2));
					tipEl.setAttribute("cy", pt[1].toFixed(2));
					tipEl.setAttribute("opacity", t > 0 && t < T.sweep[1] + 140 ? "1" : "0");

					const settle = easeOut(seg(t, T.settle));
					const un = easeOut(seg(t, T.uncover));
					inkEl.setAttribute("opacity", ((0.82 + 0.18 * settle) * (1 - un)).toFixed(3));

					for (let i = 0; i < flies.length; i++) {
						const shift = (flies[i].at - 0.45) * 500;
						const a = seg(t, [T.fly[0] + shift, T.fly[1] + shift]);
						flies[i].el.style.opacity = ((0.35 + 0.45 * a) * a).toFixed(3);
					}

					// 收焦：清晰层淡出 + 一点点推近，静态糊层淡入。
					// 全程只动 opacity / transform（交给合成器），不动 blur，所以不会掉帧。
					const fr = easeInOut(seg(t, T.focus));
					blurBox.style.display = fr > 0 ? "block" : "none";
					blurBox.style.opacity = fr.toFixed(3);
					sharpBox.style.opacity = (1 - fr).toFixed(3);
					sharpBox.style.transform = "scale(" + (1 + 0.03 * fr).toFixed(4) + ")";

					// 揭幕：以画面正中为原点，把幕布一圈圈「抠」开（放大 mask 上那个洞的半径）
					root.style.setProperty("--intro-iris", (un * irisMax).toFixed(1) + "px");
					root.style.opacity = (1 - 0.35 * un * un).toFixed(3);
					if (un >= 1) finish();
				}

				function play() {
					startedAt = performance.now();
					const tick = (now) => {
						if (finished) return;
						const t = now - startedAt;
						render(t);
						if (!finished && t < T.uncover[1] + 60) raf = requestAnimationFrame(tick);
					};
					raf = requestAnimationFrame(tick);
				}

				function start() {
					if (started || finished) return;
					started = true;
					window.clearTimeout(guard);
					const box = inkEl.getBBox();
					const inkLeft = box.x;
					inkWidth = Math.max(1, box.width);
					sweepRect.setAttribute("x", (inkLeft - 6).toFixed(2));
					irisMax = Math.hypot(window.innerWidth / 2, window.innerHeight / 2) + 40;
					window.addEventListener("click", skip);
					window.addEventListener("wheel", skip, { passive: true });
					window.addEventListener("keydown", skip);
					play();
				}

				// 兜底：1.9s 内还没能开写（字体迟迟不来之类），就把幕布撤掉，绝不让它挡着人
				const guard = window.setTimeout(() => {
					if (!started) root.remove();
				}, 1900);

				try {
					// 等签名字体就位再开写（免得用兜底字体「写」一遍）；字体确实拿不到就不播
					Promise.resolve(document.fonts && document.fonts.ready)
						.then(() => document.fonts.load('1000px "Allura Signature"'))
						.then(() => {
							if (document.fonts.check('1000px "Allura Signature"')) start();
							else root.remove();
						})
						.catch(() => root.remove());
				} catch {
					root.remove();
				}
			})();
		</script>

		<ConfigCarrier></ConfigCarrier>
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>

		<!-- 阅读进度条：贴在屏幕最上方，随正文滚动；页面太短（没什么可滚的）时自动隐藏 -->
		<div id="reading-progress" aria-hidden="true"></div>

		<!-- 主页打字机 + 随机一言（元素在 Profile 卡片里，见 widget/Profile.astro）＋ 阅读进度条的驱动 -->
		<script is:inline>
			(() => {
				if (window.__heroFxStarted) return;
				window.__heroFxStarted = true;

				// ===== 想换台词 / 句子，改这两处就行 =====
				// 打字机轮着打的话：前四句是他的身份话，后四句是他 m02515 亲口给的碎碎念（原话一字不改）
				const TYPED = [
					"Little Steps of Growth",
					"web手一枚~",
					"欢迎各位师傅的参观~",
					"yuanmuyan",
					"或许世界真的是个巨大的草台班子？",
					"原来是这样解决的嘛？！",
					"嗯？又是哪报错了······让我康康······",
					"这样改真的能修好嘛······",
				];
				const QUOTES = [
					"路漫漫其修远兮，吾将上下而求索。",
					"海内存知己，天涯若比邻。",
					"纸上得来终觉浅，绝知此事要躬行。",
					"长风破浪会有时，直挂云帆济沧海。",
					"不畏浮云遮望眼，只缘身在最高层。",
					"山有木兮木有枝，心悦君兮君不知。",
				];
				const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

				// ----- 打字机（循环打，逐字打出再逐字删掉）+ 每次刷新随机一句 -----
				let typing = null;
				const startHero = () => {
					const textEl = document.getElementById("hero-typing");
					const quoteEl = document.getElementById("hero-quote");
					if (!textEl || typing) return;

					if (quoteEl && !quoteEl.dataset.filled) {
						quoteEl.dataset.filled = "1";
						quoteEl.textContent = QUOTES[Math.floor(Math.random() * QUOTES.length)];
						requestAnimationFrame(() => {
							quoteEl.style.opacity = "0.75";
						});
					}
					if (reduce) return; // 关了动画就只留静的那一句，不删也不重打

					let i = 0;
					let pos = 0;
					let deleting = false;
					const tick = () => {
						if (!textEl.isConnected) {
							typing = null; // 换页把卡片换掉了，收工
							return;
						}
						const line = TYPED[i % TYPED.length];
						pos += deleting ? -1 : 1;
						textEl.textContent = line.slice(0, pos);
						if (!deleting && pos >= line.length) {
							deleting = true;
							typing = setTimeout(tick, 1600); // 打完停一会儿（句子多了，停短点免得轮一圈太久）
						} else if (deleting && pos <= 0) {
							deleting = false;
							i++;
							typing = setTimeout(tick, 320);
						} else {
							typing = setTimeout(tick, deleting ? 45 : 95 + Math.random() * 60);
						}
					};
					typing = setTimeout(tick, 600);
				};

				// ----- 阅读进度条（transform: scaleX 走 GPU，滚动里只做一次 rAF）-----
				const bar = document.getElementById("reading-progress");
				let raf = 0;
				const paint = () => {
					raf = 0;
					if (!bar) return;
					const doc = document.documentElement;
					const top = Math.max(window.scrollY || doc.scrollTop || 0, document.body.scrollTop || 0);
					const max = Math.max(1, (doc.scrollHeight || 0) - window.innerHeight);
					const p = Math.min(1, Math.max(0, top / max));
					bar.style.transform = "scaleX(" + p.toFixed(4) + ")";
					bar.style.opacity = max < 120 ? "0" : "1"; // 太短的页面就不显示
				};
				const onScroll = () => {
					if (!raf) raf = requestAnimationFrame(paint);
				};

				window.addEventListener("scroll", onScroll, { passive: true });
				window.addEventListener("resize", onScroll, { passive: true });
				document.addEventListener("swup:content:replace", () => {
					startHero();
					onScroll();
				});

				startHero();
				onScroll();
			})();
		</script>

		<!-- 锚点平滑滚动：自己写 easeOut 曲线，点下去立刻动（浏览器自带的 smooth 是 ease-in，长文章里开头几乎不动） -->
		<script is:inline>
			(() => {
				const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
				const ease = (t) => 1 - Math.pow(1 - t, 3);
				let raf = 0;
				const stop = () => {
					if (raf) cancelAnimationFrame(raf);
					raf = 0;
				};
				document.addEventListener(
					"click",
					(e) => {
						const a = e.target instanceof Element ? e.target.closest('a[href*="#"]') : null;
						if (!a || a.target === "_blank") return;
						let u;
						try {
							u = new URL(a.href, location.href);
						} catch {
							return;
						}
						if (!u.hash || u.pathname !== location.pathname || u.search !== location.search) return;
						const el = document.getElementById(decodeURIComponent(u.hash.slice(1)));
						if (!el) return;
						e.preventDefault();
						e.stopPropagation();
						const nav = document.getElementById("navbar");
						const off = (nav ? nav.offsetHeight : 64) + 12;
						const from = window.scrollY;
						const to = Math.max(0, el.getBoundingClientRect().top + window.scrollY - off);
						history.replaceState(null, "", u.hash);
						if (reduce || Math.abs(to - from) < 4) {
							window.scrollTo(0, to);
							return;
						}
						stop();
						const dur = Math.min(560, 200 + Math.abs(to - from) * 0.12);
						const t0 = performance.now();
						const step = (now) => {
							const t = Math.min(1, (now - t0) / dur);
							window.scrollTo(0, from + (to - from) * ease(t));
							raf = t < 1 ? requestAnimationFrame(step) : 0;
						};
						raf = requestAnimationFrame(step);
					},
					true,
				);
				for (const ev of ["wheel", "touchstart", "keydown"]) addEventListener(ev, stop, { passive: true });
			})();
		</script>

		<!-- 悬停预取：纯加速，画面上不出现任何东西 -->
		<script is:inline>
			(() => {
				if (window.__linkPrefetchInit) return;
				window.__linkPrefetchInit = true;
				const prefetched = new Set();
				window.addEventListener(
					"pointerover",
					(event) => {
						const link =
							event.target && event.target.closest ? event.target.closest("a[href]") : null;
						if (!link || link.target === "_blank" || link.hasAttribute("download")) return;
						if (link.hasAttribute("data-no-swup")) return;
						const href = link.getAttribute("href");
						if (!href || href.startsWith("#")) return;
						let url;
						try {
							url = new URL(href, location.href);
						} catch {
							return;
						}
						if (url.origin !== location.origin || prefetched.has(url.href)) return;
						prefetched.add(url.href);
						const tag = document.createElement("link");
						tag.rel = "prefetch";
						tag.as = "document";
						tag.href = url.href;
						document.head.appendChild(tag);
					},
					true,
				);

				// 手机没有 hover，上面那套预取用不上；页面彻底空下来之后，
				// 悄悄把接下来最可能点的几篇文章的 HTML 先下到缓存里（只下 HTML，图片照样点开才加载）。
				// 省流开着、或者网络是 2G/3G 的时候不做，免得偷跑流量。
				const idlePrefetch = (limit) => {
					const conn = navigator.connection;
					if (conn && (conn.saveData || /^([23]g|slow-2g)$/.test(conn.effectiveType || ""))) return;
					const hrefs = [];
					document.querySelectorAll('a[href^="/posts/"]').forEach((a) => {
						if (hrefs.length >= limit) return;
						if (a.target === "_blank" || a.hasAttribute("download")) return;
						if (a.hasAttribute("data-no-swup")) return;
						let url;
						try {
							url = new URL(a.getAttribute("href"), location.href);
						} catch {
							return;
						}
						if (url.origin !== location.origin) return;
						// /wp/ 里同一篇文章的小节链接只差 #锚点 ⇒ 去掉锚点再去重，别为同一篇发一堆预取
						url.hash = "";
						if (prefetched.has(url.href) || hrefs.indexOf(url.href) !== -1) return;
						hrefs.push(url.href);
					});
					hrefs.forEach((href) => {
						prefetched.add(href);
						const tag = document.createElement("link");
						tag.rel = "prefetch";
						tag.as = "document";
						tag.href = href;
						document.head.appendChild(tag);
					});
				};
				const startIdlePrefetch = (limit) => {
					const run = () => idlePrefetch(limit);
					if (typeof window.requestIdleCallback === "function") {
						window.requestIdleCallback(run, { timeout: 4000 });
					} else {
						window.setTimeout(run, 2500);
					}
				};
				// 索引页（/wp/、/archive/）上整页都是通往文章的链接 ⇒ 多预取几篇
				const wanted = () => (/^\/(wp|archive)\b/.test(location.pathname) ? 3 : 2);
				if (document.readyState === "complete") startIdlePrefetch(wanted());
				else window.addEventListener("load", () => startIdlePrefetch(wanted()), { once: true });
				// 站内换页（swup / Astro）之后 load 不会再触发，不补这一次的话
				// 从首页换到 /wp/ 再点题目就等于全新下载一整篇文章（116KB）。
				const reschedule = () => {
					window.setTimeout(() => startIdlePrefetch(wanted()), 250);
				};
				document.addEventListener("astro:page-load", reschedule);
				document.addEventListener("swup:page:view", reschedule);
			})();
		</script>

		<!-- 客户端换页后不再走「错峰入场」：首次打开的错峰保持不动 -->
		<script is:inline>
			document.addEventListener("swup:content:replace", () => {
				document.documentElement.classList.add("swup-navigated");
			});

			// swup 换页不会重跑「新页面里自带的内联脚本」（例如废纸堆的抽卡/图鉴逻辑），
			// 带 data-revive 的脚本在这里补跑一次；脚本自己会打 data-booted 标记，不会跑两遍。
			const revivePageScripts = () => {
				document.querySelectorAll("script[data-revive]").forEach((old) => {
					if (old.dataset.booted === "1") return;
					const fresh = document.createElement("script");
					for (const attr of old.attributes) {
						fresh.setAttribute(attr.name, attr.value);
					}
					fresh.textContent = old.textContent;
					old.replaceWith(fresh);
				});
			};
			document.addEventListener("astro:page-load", revivePageScripts);
			document.addEventListener("swup:page:view", revivePageScripts);
		</script>

		<!-- 萤火虫光点（banner 图上飞一层 + 全站背景一层）＋ 跟着鼠标的天青色光晕。想调数量/亮度/大小改下面的 CONF 就行 -->
		<script is:inline>
			(() => {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				if (window.__firefliesStarted) return;
				window.__firefliesStarted = true;

				const CONF = {
					// banner 上还是流萤：大一点、亮一点、慢慢飘
					banner: { max: 46, density: 20000, alpha: 0.9, rMin: 1.5, rMax: 3.2, glow: 8.5, speed: 0.8 },
					// 全站背景改成「星空」：点更小更暗、密度高得多 —— 每帧绘制量反而更低（光斑面积小了）
					// max 是给 4K 那种大屏兜底的上限；密度按面积算，不设上限会让每帧的渐变数量爆炸
					ambient: { max: 1200, density: 3000, alpha: 0.5, rMin: 0.7, rMax: 1.6, glow: 4, speed: 0.35, drift: 0.05, rise: 0.35 },
					drift: 0.14,
					pointer: { r: 88, alpha: 0.42, ease: 0.22, color: [[104, 226, 212], [205, 255, 248]] },
				};
				const COOL = [178, 255, 205];
				const WARM = [255, 246, 170];

				function createLayer(opts) {
					const canvas = document.createElement("canvas");
					canvas.setAttribute("aria-hidden", "true");
					const ctx = canvas.getContext("2d");
					const layer = { canvas, ctx, opts, w: 0, h: 0, dpr: 1, ps: [], dark: false };

					const spawn = () => ({
						x: Math.random() * layer.w,
						y: Math.random() * layer.h,
						r: opts.rMin + Math.random() * (opts.rMax - opts.rMin),
						ph: Math.random() * Math.PI * 2,
						sp: (0.45 + Math.random() * 0.75) * opts.speed,
						vx: (Math.random() - 0.5) * (opts.drift === undefined ? CONF.drift : opts.drift) * 2,
						vy: -(0.05 + Math.random() * 0.1) * (opts.rise === undefined ? 1 : opts.rise),
						warm: Math.random() < 0.28,
						a: opts.alpha * (0.6 + Math.random() * 0.6),
					});

					layer.resize = () => {
						const rect = canvas.getBoundingClientRect();
						const w = Math.max(1, Math.round(rect.width));
						const h = Math.max(1, Math.round(rect.height));
						const dpr = Math.min(window.devicePixelRatio || 1, 2);
						if (w === layer.w && h === layer.h && dpr === layer.dpr) return;
						layer.w = w;
						layer.h = h;
						layer.dpr = dpr;
						canvas.width = Math.round(w * dpr);
						canvas.height = Math.round(h * dpr);
						ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
						// 小屏（手机）按等效 4500 的密度（3000 / 4500 = 2/3）：小屏太密会显得脏，也省电
						const scale = w < 800 ? 2 / 3 : 1;
						const n = Math.max(6, Math.min(opts.max, Math.round(((w * h) / opts.density) * scale)));
						while (layer.ps.length > n) layer.ps.pop();
						while (layer.ps.length < n) layer.ps.push(spawn());
					};

					layer.step = (dt) => {
						const f = dt / 16.67;
						for (const p of layer.ps) {
							p.ph += p.sp * 0.02 * f;
							p.x += (p.vx + Math.sin(p.ph * 1.7) * 0.06) * f;
							p.y += (p.vy + Math.cos(p.ph * 1.3) * 0.05) * f;
							if (p.y < -40) p.y = layer.h + 30;
							if (p.y > layer.h + 40) p.y = -30;
							if (p.x < -40) p.x = layer.w + 30;
							if (p.x > layer.w + 40) p.x = -30;
						}
					};

					layer.draw = () => {
						ctx.clearRect(0, 0, layer.w, layer.h);
						ctx.globalCompositeOperation = layer.dark ? "lighter" : "source-over";
						const boost = layer.dark ? 1 : 1.5;
						for (const p of layer.ps) {
							const blink = 0.5 + 0.5 * Math.sin(p.ph);
							const a = Math.min(1, p.a * boost * (0.3 + 0.7 * blink));
							if (a < 0.012) continue;
							const c = p.warm ? WARM : COOL;
							const rr = p.r * opts.glow;
							const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, rr);
							g.addColorStop(0, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", " + a + ")");
							g.addColorStop(0.35, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", " + a * 0.35 + ")");
							g.addColorStop(1, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", 0)");
							ctx.fillStyle = g;
							ctx.beginPath();
							ctx.arc(p.x, p.y, rr, 0, Math.PI * 2);
							ctx.fill();
							ctx.fillStyle = "rgba(255, 255, 245, " + Math.min(0.5, a * 0.8) + ")";
							ctx.beginPath();
							ctx.arc(p.x, p.y, p.r * 0.42, 0, Math.PI * 2);
							ctx.fill();
						}
						ctx.globalCompositeOperation = "source-over";
					};

					return layer;
				}

				const layers = [];

				// 全站环境层：跟 html::before 的背景图同一层（但在它上面），所以在卡片和文字后面。
				// 挂在 <html> 上而不是 body，免得被 OverlayScrollbars 新建的 viewport 包裹层挡在后面
				const ambient = createLayer(CONF.ambient);
				ambient.canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:-1";
				document.documentElement.insertBefore(ambient.canvas, document.body);
				layers.push(ambient);

				// banner 层：贴在 #banner-wrapper 里、盖在 banner 图上（Swup 换页把它换掉了就再贴回去）
				const banner = createLayer(CONF.banner);
				banner.canvas.style.cssText = "position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1";
				layers.push(banner);

				// 鼠标光晕：跟着指针走的一团天青色柔光（色值取自 banner 上流萤的光环 #a4dbd0）。
				// 只在有精准指针的设备上挂事件，手机完全不受影响。
				const glow = (() => {
					const opts = CONF.pointer;
					const canvas = document.createElement("canvas");
					canvas.setAttribute("aria-hidden", "true");
					const ctx = canvas.getContext("2d");
					canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:40";
					document.documentElement.insertBefore(canvas, document.body);
					const host = { canvas, ctx, w: 0, h: 0, dpr: 1, dark: false, active: false, x: 0, y: 0, tx: 0, ty: 0, r: opts.r, tr: opts.r };

					host.resize = () => {
						const dpr = Math.min(window.devicePixelRatio || 1, 2);
						const w = Math.max(1, window.innerWidth);
						const h = Math.max(1, window.innerHeight);
						if (w === host.w && h === host.h && dpr === host.dpr) return;
						host.w = w;
						host.h = h;
						host.dpr = dpr;
						canvas.width = Math.round(w * dpr);
						canvas.height = Math.round(h * dpr);
						ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					};

					host.step = (dt) => {
						const f = dt / 16.67;
						const ease = Math.min(1, opts.ease * f);
						host.x += (host.tx - host.x) * ease;
						host.y += (host.ty - host.y) * ease;
						host.r += (host.tr - host.r) * Math.min(1, 0.08 * f);
					};

					host.draw = () => {
						ctx.clearRect(0, 0, host.w, host.h);
						if (!host.active || !host.w) return;
						ctx.globalCompositeOperation = host.dark ? "lighter" : "source-over";
						const c = opts.color[host.dark ? 1 : 0];
						const a = opts.alpha * (host.dark ? 1 : 1.25);
						const g = ctx.createRadialGradient(host.x, host.y, 0, host.x, host.y, host.r);
						g.addColorStop(0, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", " + a + ")");
						g.addColorStop(0.16, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", " + a * 0.78 + ")");
						g.addColorStop(0.45, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", " + a * 0.3 + ")");
						g.addColorStop(1, "rgba(" + c[0] + ", " + c[1] + ", " + c[2] + ", 0)");
						ctx.fillStyle = g;
						ctx.beginPath();
						ctx.arc(host.x, host.y, host.r, 0, Math.PI * 2);
						ctx.fill();
						ctx.globalCompositeOperation = "source-over";
					};

					return host;
				})();

				if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
					window.addEventListener(
						"pointermove",
						(e) => {
							if (!glow.active) {
								glow.x = e.clientX;
								glow.y = e.clientY;
								glow.active = true;
							}
							glow.tx = e.clientX;
							glow.ty = e.clientY;
							const sp = Math.abs(e.movementX || 0) + Math.abs(e.movementY || 0);
							glow.tr = CONF.pointer.r * (1 + Math.min(0.4, sp / 120));
						},
						{ passive: true },
					);
					window.addEventListener("pointerleave", () => {
						glow.active = false;
					});
				}

				layers.push(glow);

				const mountBanner = () => {
					const wrap = document.getElementById("banner-wrapper");
					if (!wrap) return;
					if (banner.canvas.parentNode !== wrap) {
						wrap.appendChild(banner.canvas);
						banner.resize();
					}
				};

				mountBanner();
				for (const l of layers) l.resize();

				const applyTheme = () => {
					const dark = document.documentElement.classList.contains("dark");
					for (const l of layers) l.dark = dark;
				};
				applyTheme();
				new MutationObserver(applyTheme).observe(document.documentElement, {
					attributes: true,
					attributeFilter: ["class"],
				});

				window.addEventListener(
					"resize",
					() => {
						for (const l of layers) l.resize();
					},
					{ passive: true },
				);
				setInterval(() => {
					mountBanner();
					for (const l of layers) l.resize();
				}, 1200);

				let last = performance.now();
				const frame = (now) => {
					requestAnimationFrame(frame);
					if (document.hidden) return;
					const dt = Math.min(now - last, 64);
					last = now;
					for (const l of layers) {
						if (!l.canvas.isConnected || !l.w) continue;
						l.step(dt);
						l.draw();
					}
				};
				requestAnimationFrame(frame);
			})();
		</script>
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}vh`,
	'banner-height': `${BANNER_HEIGHT}vh`,
}}>
@tailwind components;
@layer components {
