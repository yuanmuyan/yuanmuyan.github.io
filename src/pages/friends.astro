---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="友链" description="我的朋友们">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="text-2xl font-bold text-[var(--primary)] mb-3">朋友们</div>
            <div class="text-black/50 dark:text-white/50 mb-6">这里是我的朋友们，欢迎去他们的站点逛逛。</div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <a href="https://map1e-suk1.github.io/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                  <img src="https://map1e-suk1.github.io/avatar.webp" alt="Map1e-Suk1" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">Map1e-Suk1</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">Astro + Fuwari，写题解的那位</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://kioroshiaki.github.io/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://kioroshiaki.github.io/img/blowfish_logo.png" alt="Kioroshi Aki" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">Kioroshi Aki</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">Hugo + Blowfish，主攻 Pwn</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://piyuanzhoulv.github.io/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://piyuanzhoulv.github.io/images/logo.png" alt="圆周率的废纸堆" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">圆周率的废纸堆</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">里面或许有你需要的？</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://aclosure.github.io/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://aclosure.github.io/images/Ak_char_007_closre_3.png" alt="aClosure" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">aClosure</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">Ciallo~</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://blog.3w3.asia/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://blog.3w3.asia/favicon.png" alt="宛宛" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">宛宛（Wan blog）</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">自建 Rin，人生五十年，如梦亦如幻</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://ch0kk4ku.github.io/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://ch0kk4ku.github.io/_astro/avatar.yr5wXXsA.avif" alt="Ch0kk4ku" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">Ch0kk4ku</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">Astro + Firefly，有趣有盼，无灾无难</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://xiaolang0817.github.io/personal_blog/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://xiaolang0817.github.io/personal_blog/touxiang.jpg" alt="dalang" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">dalang</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">手写 HTML，健身与碎碎念</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
                <a href="https://aaaa521.github.io/mortal-blog/" target="_blank" rel="noopener noreferrer" class="card-base card-shadow p-4 flex items-center gap-4 group transition hover:-translate-y-0.5 active:scale-[0.99]">
                    <img src="https://aaaa521.github.io/mortal-blog/avatar.png" alt="Mortal" class="w-12 h-12 rounded-full shrink-0 object-cover" />
                    <div class="min-w-0 flex-1">
                        <div class="text-lg font-bold truncate text-black dark:text-white transition group-hover:text-[var(--primary)]">Mortal</div>
                        <div class="text-sm text-black/40 dark:text-white/40 truncate">网络安全学习者 / CTF 选手的学习记录</div>
                    </div>
                    <span class="text-black/20 dark:text-white/20 group-hover:text-[var(--primary)] transition shrink-0">↗</span>
                </a>
            </div>

            <div class="mt-8 pt-6 border-t border-black/10 dark:border-white/10">
                <div class="text-xl font-bold text-[var(--primary)] mb-2">求友链！</div>
                <div class="text-sm text-black/60 dark:text-white/60 leading-relaxed">
                    <p>不论大佬还是萌新，都欢迎来投友链~ 工具站也可以（原则上只收开源 / 免费的）。</p>
                    <p class="mt-2">想换的话，在 <a class="text-[var(--primary)] hover:underline" href="https://github.com/yuanmuyan" target="_blank" rel="noopener noreferrer">GitHub</a> 上找我就行，麻烦把这四项一起发过来：</p>
                    <ol class="list-decimal list-inside mt-3 space-y-1">
                        <li><span class="font-bold">显示名称</span>：比如「XXX 的博客」</li>
                        <li><span class="font-bold">一句话简介</span>：会显示在友链卡片上</li>
                        <li><span class="font-bold">URL</span>：你的站点地址</li>
                        <li><span class="font-bold">Icon</span>：建议方形，img 标签能显示的格式都行（也可以直接给图片链接）</li>
                    </ol>
                </div>

                <div class="text-xl font-bold text-[var(--primary)] mt-6 mb-2">++ 我？</div>
                <div class="text-sm text-black/60 dark:text-white/60">想在你的站点上加我（不是必须的啦），四项信息都在这儿：</div>
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
                    <div><span class="text-black/40 dark:text-white/40">名称　</span><span class="text-black dark:text-white">yuanmuyan</span></div>
                    <div><span class="text-black/40 dark:text-white/40">简介　</span><span class="text-black dark:text-white">web 手一枚~，欢迎各位师傅的参观~</span></div>
                    <div class="sm:col-span-2 break-all"><span class="text-black/40 dark:text-white/40">URL　　</span><span class="text-black dark:text-white">https://yuanmuyan.github.io/</span></div>
                    <div class="sm:col-span-2 break-all"><span class="text-black/40 dark:text-white/40">Icon　　</span><span class="text-black dark:text-white">https://yuanmuyan.github.io/favicon/avatar-180.png</span></div>
                </div>
                <button id="copy-friend-info" type="button" class="mt-3 px-3 py-1.5 rounded-lg text-sm btn-regular transition active:scale-[0.98]">复制这四项</button>
                <script is:inline>
                    (() => {
                        const btn = document.getElementById("copy-friend-info");
                        if (!btn) return;
                        const info = [
                            "名称：yuanmuyan",
                            "简介：web 手一枚~，欢迎各位师傅的参观~",
                            "URL：https://yuanmuyan.github.io/",
                            "Icon：https://yuanmuyan.github.io/favicon/avatar-180.png",
                        ].join("\n");
                        btn.addEventListener("click", async () => {
                            try {
                                await navigator.clipboard.writeText(info);
                                btn.textContent = "已复制 ✓";
                            } catch {
                                btn.textContent = "复制失败，手动选一下吧";
                            }
                            setTimeout(() => (btn.textContent = "复制这四项"), 1600);
                        });
                    })();
                </script>
            </div>
        </div>
    </div>
</MainGridLayout>
